<html>
<head>
<link rel="stylesheet" href="lib://net.rptools.maptool/css/mt-stat-sheet.css?cachelib=false"/>
<link rel="stylesheet" href="./sheet.css?cachelib=false"/>
</head>
<body>
<div id="statSheet" class="{{statSheetLocation}}">
<div class="sta char">
<div class="hdr">
{{#if portrait}}<img class="pt" src="{{portrait}}"/>{{else if image}}<img class="pt" src="{{image}}"/>{{/if}}
<div class="id"><div class="nm">{{name}}</div>
<div class="sub">{{#each properties}}{{#eq name "Species"}}<span>{{value}}</span>{{/eq}}{{#eq name "Rank"}}<span>{{value}}</span>{{/eq}}{{#eq name "Role"}}<span>{{value}}</span>{{/eq}}{{/each}}</div>
{{#each properties}}{{#eq name "Status"}}<div class="status">{{value}}</div>{{/eq}}{{/each}}
</div></div>
<table class="g"><tr>{{#each properties}}{{#eq name "Control"}}<td><div class="k">CTRL</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Daring"}}<td><div class="k">DAR</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Fitness"}}<td><div class="k">FIT</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Insight"}}<td><div class="k">INS</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Presence"}}<td><div class="k">PRE</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Reason"}}<td><div class="k">REA</div><div class="v">{{value}}</div></td>{{/eq}}{{/each}}</tr></table><table class="g"><tr>{{#each properties}}{{#eq name "Command"}}<td><div class="k">CMD</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Conn"}}<td><div class="k">CONN</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Engineering"}}<td><div class="k">ENG</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Medicine"}}<td><div class="k">MED</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Science"}}<td><div class="k">SCI</div><div class="v">{{value}}</div></td>{{/eq}}{{#eq name "Security"}}<td><div class="k">SEC</div><div class="v">{{value}}</div></td>{{/eq}}{{/each}}</tr></table>{{#each properties}}{{#eq name "StressText"}}<div class="ln "><span class="lk">Stress</span> {{value}}</div>{{/eq}}{{#eq name "StressPct"}}<div class="bar"><div class="fill stress" style="width:{{value}}%"></div></div>{{/eq}}{{#eq name "DeterminationText"}}<div class="ln "><span class="lk">Determination</span> {{value}}</div>{{/eq}}{{#eq name "InjuryList"}}<div class="ln bad"><span class="lk">Injuries</span> {{value}}</div>{{/eq}}{{#eq name "FocusList"}}<div class="ln dim"><span class="lk">Focuses</span> {{value}}</div>{{/eq}}{{/each}}</div></div>
</body>
</html>
