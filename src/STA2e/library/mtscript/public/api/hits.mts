[h: "STA2e API: hits waiting for the target to avoid the Injury or accept it (p.292). Args: add (hit id to hit) and remove (list of hit ids). The current list is read in the same call, so hits from several attacks are all kept. Returns ok and the new Hits object."]
[h: ns = "lib:net.wizardsgate.sta2e"]
[h: req = macro.args]
[h: add = json.get(req, "add")]
[h: add = if(json.type(add) == "OBJECT", add, "{}")]
[h: rem = json.get(req, "remove")]
[h: rem = if(json.type(rem) == "ARRAY", rem, "[]")]
[h: all = getLibProperty("Hits", ns)]
[h: all = if(json.type(all) == "OBJECT", all, "{}")]
[h: addIds = json.fields(add, "json")]
[h, foreach(k, addIds): all = json.set(all, k, json.get(add, k))]
[h, foreach(k, rem): all = json.remove(all, k)]
[h: setLibProperty("Hits", all, ns)]
[r: json.set("{}", "ok", 1, "Hits", all)]
