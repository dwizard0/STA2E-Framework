[h: "STA2e API: read token properties. Args: tokens (list of id and map) and props (list of names). Returns an object keyed by token id. Players only get tokens on maps they can see, and Notes are blank on tokens they don't own. Tokens that aren't on the given map any more are left out."]
[h: req = macro.args]
[h: list = json.get(req, "tokens")]
[h: props = json.get(req, "props")]
[h: gm = isGM()]
[h: me = getPlayerName()]
[h: maps = if(gm == 1, getAllMapNames("json"), getVisibleMapNames("json"))]
[h: out = "{}"]
[h, foreach(t, list), code: {
  [h: id = json.get(t, "id")]
  [h: m = json.get(t, "map")]
  [h: see = json.contains(maps, m)]
  [h, if(see == 1): see = if(findToken(id, m) == "", 0, 1)]
  [h, if(see == 1), code: {
    [h: mine = if(gm == 1, 1, isOwner(me, id, m))]
    [h: p = "{}"]
    [h, foreach(k, props): p = json.set(p, k, getProperty(k, id, m))]
    [h, if(mine == 0): p = json.set(p, "Notes", "")]
    [h: out = json.set(out, id, json.set("{}", "name", getName(id, m), "type", getPropertyType(id, m), "map", m, "props", p))]
  }]
}]
[r: out]
