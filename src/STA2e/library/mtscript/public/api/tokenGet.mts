[h: "STA2e API: read token properties. Args: tokens (list of id and map) and props (list of names). Returns an object keyed by token id. Players only get tokens on maps they can see, not on the GM layer (or hidden from players, on the current map) unless they own them, and Notes are blank on tokens they don't own. Tokens that aren't on the given map any more are left out."]
[h: req = macro.args]
[h: list = json.get(req, "tokens")]
[h: props = json.get(req, "props")]
[h: gm = isGM()]
[h: me = getPlayerName()]
[h: maps = if(gm == 1, getAllMapNames("json"), getVisibleMapNames("json"))]
[h: cur = getCurrentMapName()]
[h: out = "{}"]
[h, foreach(t, list), code: {
  [h: id = json.get(t, "id")]
  [h: m = json.get(t, "map")]
  [h: see = json.contains(maps, m)]
  [h, if(see == 1): see = if(findToken(id, m) == "", 0, 1)]
  [h: mine = gm]
  [h, if(see == 1): mine = if(gm == 1, 1, isOwner(me, id, m))]
  [h: chk = see * (1 - mine)]
  [h, if(chk == 1): see = if(getLayer(id, m) == "GM", 0, 1)]
  [h: "getVisible only looks on the current map."]
  [h: chk = if(m == cur, see * (1 - mine), 0)]
  [h, if(chk == 1): see = getVisible(id)]
  [h, if(see == 1), code: {
    [h: p = "{}"]
    [h, foreach(k, props): p = json.set(p, k, getProperty(k, id, m))]
    [h, if(mine == 0): p = json.set(p, "Notes", "")]
    [h: out = json.set(out, id, json.set("{}", "name", getName(id, m), "type", getPropertyType(id, m), "map", m, "props", p))]
  }]
}]
[r: out]
