[h: "STA2e API: change banked assists. Args: add (token id to a list of assist entries) and remove (token id to a list of assist ids). The current assists are read in the same call, so players banking or using assists at the same time don't overwrite each other. Returns ok and the new Assists object."]
[h: ns = "lib:net.wizardsgate.sta2e"]
[h: req = macro.args]
[h: add = json.get(req, "add")]
[h: rem = json.get(req, "remove")]
[h: all = getLibProperty("Assists", ns)]
[h: all = if(json.type(all) == "OBJECT", all, "{}")]
[h: add = if(json.type(add) == "OBJECT", add, "{}")]
[h: addIds = json.fields(add, "json")]
[h, foreach(tid, addIds), code: {
  [h: cur = json.get(all, tid)]
  [h: cur = if(json.type(cur) == "ARRAY", cur, "[]")]
  [h: more = json.get(add, tid)]
  [h: more = if(json.type(more) == "ARRAY", more, "[]")]
  [h: all = json.set(all, tid, json.merge(cur, more))]
}]
[h: rem = if(json.type(rem) == "OBJECT", rem, "{}")]
[h: remIds = json.fields(rem, "json")]
[h, foreach(tid, remIds), code: {
  [h: cur = json.get(all, tid)]
  [h: cur = if(json.type(cur) == "ARRAY", cur, "[]")]
  [h: drop = json.get(rem, tid)]
  [h: drop = if(json.type(drop) == "ARRAY", drop, "[]")]
  [h: keep = "[]"]
  [h, foreach(a, cur): keep = if(json.contains(drop, json.get(a, "id")), keep, json.append(keep, a))]
  [h: left = json.length(keep)]
  [h, if(left == 0): all = json.remove(all, tid); all = json.set(all, tid, keep)]
}]
[h: setLibProperty("Assists", all, ns)]
[r: json.set("{}", "ok", 1, "Assists", all)]
