[h: "STA2e API: session context. Returns the player, the selection, and every STA2e token on the maps this player can see."]
[h: gm = isGM()]
[h: me = getPlayerName()]
[h: types = json.append("[]", "STA2e Character", "STA2e Ship")]
[h, if(gm): maps = getAllMapNames("json"); maps = getVisibleMapNames("json")]
[h: tokens = "[]"]
[h, foreach(m, maps), code: {
  [h: ids = getTokens("json", json.set("{}", "propertyType", types, "mapName", m))]
  [h, foreach(id, ids): tokens = json.append(tokens, json.set("{}", "id", id, "map", m, "name", getName(id, m), "type", getPropertyType(id, m), "owner", isOwner(me, id, m), "img", getTokenImage(64, id, m)))]
}]
[h: cur = getCurrentMapName()]
[h: sel = getSelected("json")]
[h: selected = "[]"]
[h, foreach(id, sel): selected = json.append(selected, json.set("{}", "id", id, "map", cur, "name", getName(id, cur), "type", getPropertyType(id, cur), "owner", isOwner(me, id, cur), "img", getTokenImage(64, id, cur)))]
[h: imp = getImpersonated()]
[h: "Are the STA2e token types in this campaign? 2 = yes with the stat sheet fields, 1 = old version, 0 = missing."]
[h: cp = getAllPropertyNames("STA2e Character", "json")]
[h: sp = getAllPropertyNames("STA2e Ship", "json")]
[h: "Keep roll-option conditions to one level of brackets: MapTool can't parse deeper nesting there."]
[h: nC = json.length(cp)]
[h: nS = json.length(sp)]
[h: hasSheet = json.contains(cp, "StressText")]
[h: typesState = if(nC * nS == 0, 0, 1 + hasSheet)]
[h: out = json.set("{}", "isGM", gm, "player", me, "map", cur, "tokens", tokens, "selected", selected, "impersonated", imp, "types", typesState, "api", 1)]
[r: out]
