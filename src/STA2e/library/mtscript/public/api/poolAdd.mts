[h: "STA2e API: change Momentum and Threat by an amount. The current values are read in the same call, so players acting at the same time don't overwrite each other's spends. Args: momentum and threat (amounts, may be negative), strict (1 = refuse rather than clamp when a pool would drop below 0). Players may add Threat; only the GM may spend it."]
[h: ns = "lib:net.wizardsgate.sta2e"]
[h: req = macro.args]
[h: dm = json.get(req, "momentum")]
[h: dm = if(isNumber(dm), dm, 0)]
[h: dt = json.get(req, "threat")]
[h: dt = if(isNumber(dt), dt, 0)]
[h: strict = json.get(req, "strict")]
[h: strict = if(isNumber(strict), strict, 0)]
[h: gm = isGM()]
[h: m = getLibProperty("Momentum", ns)]
[h: m = if(isNumber(m), m, 0)]
[h: t = getLibProperty("Threat", ns)]
[h: t = if(isNumber(t), t, 0)]
[h: newM = m + dm]
[h: newT = t + dt]
[h: err = ""]
[h, if(dt < 0): err = if(gm == 1, "", "gmOnly")]
[h, if(strict == 1): err = if(newM < 0, "notEnoughMomentum", err)]
[h, if(strict == 1): err = if(newT < 0, "notEnoughThreat", err)]
[h: "The group pool holds at most 6 (p.261); anything above that is lost."]
[h: newM = min(max(newM, 0), 6)]
[h: newT = max(newT, 0)]
[h: ok = if(err == "", 1, 0)]
[h, if(ok == 1): setLibProperty("Momentum", newM, ns)]
[h, if(ok == 1): setLibProperty("Threat", newT, ns)]
[h, if(ok == 0): newM = m]
[h, if(ok == 0): newT = t]
[h: out = json.set("{}", "ok", ok, "error", err, "Momentum", newM, "Threat", newT, "dMomentum", newM - m, "dThreat", newT - t)]
[r: out]
