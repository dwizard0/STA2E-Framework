[h: "STA2e API: create a token in the middle of the current view. Args: name, type, image, pc (1 or 0). Returns id, map and name."]
[h: req = macro.args]
[h: "createToken takes grid cells for x and y, so ask for the view centre in cells."]
[h: c = getViewCenter(0, "json")]
[h: spec = json.set("{}", "name", json.get(req, "name"), "tokenImage", json.get(req, "image"), "layer", "TOKEN", "propertyType", json.get(req, "type"), "x", json.get(c, "centerX"), "y", json.get(c, "centerY"))]
[h: "createToken fails with an error MapTool never passes back to the window when the type is missing, so check first."]
[h: known = json.length(getAllPropertyNames(json.get(req, "type"), "json"))]
[h, if(known == 0): out = json.set("{}", "ok", 0, "error", "noType", "type", json.get(req, "type"))]
[h, if(known > 0), code: {
  [h: id = createToken(spec)]
  [h: m = getCurrentMapName()]
  [h, if(json.get(req, "pc") == 1): setPC(id, m); setNPC(id, m)]
  [h, if(isGM() == 0): setOwner(getPlayerName(), id, m)]
  [h: out = json.set("{}", "ok", 1, "id", id, "map", m, "name", getName(id, m))]
}]
[r: out]
