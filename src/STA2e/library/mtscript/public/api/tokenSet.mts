[h: "STA2e API: write token properties. Args: id, map, props (name to value), optional type, optional name. The GM and the token's owners may change anything. Other players may change only the conflict-state properties their actions affect on someone else's token (an Injury they inflict, Stress they help an ally recover, the shared ship's shields and power), and may not rename or retype it. Returns ok, the number of properties written, and the refused keys."]
[h: req = macro.args]
[h: id = json.get(req, "id")]
[h: m = json.get(req, "map")]
[h: props = json.get(req, "props")]
[h: newType = json.get(req, "type")]
[h: newName = json.get(req, "name")]
[h: full = isGM()]
[h, if(full == 0): full = isOwner(getPlayerName(), id, m)]
[h: shared = json.append("[]", "Stress", "Injuries", "Defeated", "Shields", "Breaches", "Effects", "ReservePower", "ReroutedSystem", "RegainAttempts")]
[h: "Display fields for the hover stat sheet are recomputed with every save, so they are always allowed."]
[h: shared = json.merge(shared, json.append("[]", "StressText", "StressPct", "DeterminationText", "Status", "InjuryList", "FocusList", "ShieldsText", "ShieldsPct", "Resistance", "PowerStatus", "BreachList", "EffectList"))]
[h: refused = "[]"]
[h: doType = if(newType == "", 0, full)]
[h: doName = if(newName == "", 0, full)]
[h, if(doType == 1): setPropertyType(newType, id, m)]
[h, if(doName == 1): setName(newName, id, m)]
[h, if(newType != ""): refused = if(full == 1, refused, json.append(refused, "type"))]
[h, if(newName != ""): refused = if(full == 1, refused, json.append(refused, "name"))]
[h: keys = json.fields(props, "json")]
[h: written = 0]
[h, foreach(k, keys), code: {
  [h: allowed = if(full == 1, 1, json.contains(shared, k))]
  [h, if(allowed == 1): setProperty(k, json.get(props, k), id, m); refused = json.append(refused, k)]
  [h: written = written + allowed]
}]
[h: ok = if(json.length(refused) == 0, 1, 0)]
[r: json.set("{}", "ok", ok, "count", written, "refused", refused)]
