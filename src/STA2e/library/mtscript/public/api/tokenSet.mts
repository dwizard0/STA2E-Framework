[h: "STA2e API: write token properties. Args: id, map, props (name to value), optional type, optional name."]
[h: req = macro.args]
[h: id = json.get(req, "id")]
[h: m = json.get(req, "map")]
[h: props = json.get(req, "props")]
[h: newType = json.get(req, "type")]
[h: newName = json.get(req, "name")]
[h, if(newType != ""): setPropertyType(newType, id, m)]
[h, if(newName != ""): setName(newName, id, m)]
[h: keys = json.fields(props, "json")]
[h, foreach(k, keys): setProperty(k, json.get(props, k), id, m)]
[r: json.set("{}", "ok", 1, "count", json.length(keys))]
