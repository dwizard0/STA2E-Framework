[h: "STA2e API: change one extended task or consequence. Args: id and patch (fields to set). The list is read in the same call, so changes made to other tasks at the same time are kept. Players may change only progress, done, bonusNext and log; creating and deleting tasks, and other fields, stay with the GM. Returns ok, found, refused (fields a player may not change) and the list."]
[h: ns = "lib:net.wizardsgate.sta2e"]
[h: req = macro.args]
[h: id = json.get(req, "id")]
[h: patch = json.get(req, "patch")]
[h: patch = if(json.type(patch) == "OBJECT", patch, "{}")]
[h: gm = isGM()]
[h: playerFields = json.append("[]", "progress", "done", "bonusNext", "log")]
[h: refused = "[]"]
[h: fields = json.fields(patch, "json")]
[h, foreach(f, fields), code: {
  [h: allowed = if(gm == 1, 1, json.contains(playerFields, f))]
  [h, if(allowed == 0): refused = json.append(refused, f)]
}]
[h: permitted = if(json.length(refused) == 0, 1, 0)]
[h: store = getLibProperty("Extended", ns)]
[h: store = if(json.type(store) == "OBJECT", store, "{}")]
[h: list = json.get(store, "list")]
[h: list = if(json.type(list) == "ARRAY", list, "[]")]
[h: out = "[]"]
[h: found = 0]
[h, foreach(x, list), code: {
  [h: hit = if(json.get(x, "id") == id, 1, 0)]
  [h, if(hit == 1): found = 1]
  [h: change = hit * permitted]
  [h, if(change == 1): x = json.merge(x, patch)]
  [h: out = json.append(out, x)]
}]
[h: write = found * permitted]
[h, if(write == 1): setLibProperty("Extended", json.set("{}", "list", out), ns); out = list]
[r: json.set("{}", "ok", write, "found", found, "refused", refused, "list", out)]
