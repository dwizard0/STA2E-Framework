[h: "STA2e API: move a token to the middle of the current view. Args: id, map. The token must be on the current map. Only the GM or the token's owner may move it."]
[h: req = macro.args]
[h: id = json.get(req, "id")]
[h: m = json.get(req, "map")]
[h: cur = getCurrentMapName()]
[h: here = if(m == cur, 1, 0)]
[h: found = ""]
[h, if(here == 1): found = findToken(id, m)]
[h: may = 0]
[h, if(found != ""): may = if(isGM() == 1, 1, isOwner(getPlayerName(), id, m))]
[h: out = json.set("{}", "ok", 0, "error", "notAllowed")]
[h, if(here == 0): out = json.set("{}", "ok", 0, "error", "wrongMap", "map", m)]
[h: gone = if(found == "", here, 0)]
[h, if(gone == 1): out = json.set("{}", "ok", 0, "error", "noToken")]
[h, if(may == 1), code: {
  [h: c = getViewCenter(0, "json")]
  [h: moveToken(json.get(c, "centerX"), json.get(c, "centerY"), 0, id)]
  [h: out = json.set("{}", "ok", 1)]
}]
[r: out]
