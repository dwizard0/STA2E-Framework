[h: "STA2e Remote API: send one request to the relay server and return its answer. Args: url, body (JSON text). GM only."]
[h: req = macro.args]
[h: url = json.get(req, "url")]
[h: body = json.get(req, "body")]
[h: allowed = isExternalMacroAccessAllowed()]
[h: gm = isGM()]
[h: out = json.set("{}", "ok", 0, "error", "gmOnly")]
[h, if(gm == 1): out = json.set("{}", "ok", 0, "error", "externalAccessOff")]
[h: go = gm * allowed]
[h, if(go == 1): out = REST.post(url, body, "application/json")]
[r: out]
